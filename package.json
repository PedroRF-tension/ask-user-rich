{
  "name": "ask-user-rich",
  "version": "1.0.0",
  "description": "Claude Code mod: one stable Thread page per conversation for the model's questions, answered in a rich form, answers that come back by themselves",
  "license": "MIT",
  "author": "Pedro Felicio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedroRF-tension/ask-user-rich.git"
  },
  "homepage": "https://github.com/PedroRF-tension/ask-user-rich#readme",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "claude",
    "ask-user",
    "interview",
    "form",
    "grilling"
  ],
  "type": "module",
  "files": [
    ".claude-plugin/",
    "hooks/",
    "types/",
    "daemon/",
    "src/",
    "public/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-timeout=30000 test/*.test.js",
    "test:mod": "claude plugin test .",
