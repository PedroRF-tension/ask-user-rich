{
  "name": "ask-user-rich",
  "version": "0.3.0",
  "description": "MCP server: long structured interviews answered in a local browser form",
  "license": "MIT",
  "author": "Pedro Felicio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedroRF-tension/ask-user-rich.git"
  },
  "homepage": "https://github.com/PedroRF-tension/ask-user-rich#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "claude",
    "ask-user",
    "interview",
    "form"
  ],
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "ask-user-rich": "src/server.js"
  },
  "files": [
    "src/",
    "public/",
    "run.sh",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "./run.sh",
    "dev": "node scripts/dev.mjs",
    "test": "node --test --test-timeout=20000 test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dompurify": "3.4.15",
    "marked": "18.0.14",
    "zod": "4.6.5"
  }
}
